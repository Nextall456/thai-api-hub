# ===== Thai API Hub - ตั้งค่าหลัก =====

HOST=127.0.0.1
PORT=8077

# กุญแจสำหรับเซ็น session (เปลี่ยนเป็นข้อความสุ่มยาวๆ)
SECRET_KEY=please-change-me-to-random-string

# OpenRouter API key (https://openrouter.ai/keys) - เว้นว่างไว้ = ใช้เฉพาะโมเดลในเครื่อง
OPENROUTER_API_KEY=

# Local AI (Ollama) ที่รันบนเครื่องนี้
OLLAMA_BASE_URL=http://127.0.0.1:11434
# ลำดับโมเดลในเครื่องที่จะใช้ (คั่นด้วย ,) — เช่น qwen2.5:7b, jarvis-llama3.1:latest, llama3.2:latest
LOCAL_MODELS=qwen2.5:7b,jarvis-llama3.1:latest,llama3.2:latest

# อีเมลผู้ดูแลระบบ (สมัครสมาชิกด้วยอีเมลนี้ = ได้สิทธิ์แอดมินทันที) คั่นด้วย ,
ADMIN_EMAILS=admin@example.com

# บัญชีธนาคารสำหรับรับเงิน (แสดงในหน้าบิล) — รูป QR ตัวจริงวางไว้ที่ app/static/payment-qr.jpg (ใช้รูปเดิม ไม่ต้องเจน)
PAYMENT_BANK=ธนาคารแลนด์แอนด์เฮ้าส์
PAYMENT_ACCOUNT_NO=005 2036481
PAYMENT_ACCOUNT_NAME=คำรณ โพธิ์มะณี

# ทดลองใช้ฟรีหลังสมัคร
TRIAL_DAYS=7

SITE_NAME=Thai API Hub
SITE_URL=http://localhost:8077



# ตรวจสอบการชำระเงินอัตโนมัติ (true/false) — true = อนุมัติทันทีเมื่อลูกค้ากดแจ้งชำระ (ปิด = แอดมินกดอนุมัติเอง)
AUTO_VERIFY_PAYMENT=false

# Analytics — ใส่เมื่อมี (เว้นว่าง = ปิด)
GA_ID=
PLAUSIBLE_DOMAIN=

# Email notifications (SMTP เช่น Gmail app password / Resend / SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# LINE Messaging API (แนะนำสำหรับลูกค้าไทย)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
